# Nilai publik dari Supabase Dashboard → Project Settings → API.
# Anon key memang digunakan di browser dan harus selalu dilindungi Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ANON_PUBLIC_KEY

# Jangan pernah menambahkan SUPABASE_SERVICE_ROLE_KEY ke aplikasi atau GitHub Pages.
