# Nilai publik dari Supabase Dashboard → Project Settings → API.
# Publishable key memang digunakan di browser dan harus selalu dilindungi Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXAMPLE

# Opsional: URL HTTPS worker Qwen3-TTS yang Anda host sendiri.
# Jangan taruh token rahasia di NEXT_PUBLIC_*.
NEXT_PUBLIC_QWEN_TTS_ENDPOINT=https://qwen-worker.example.com

# Legacy anon key masih didukung sebagai fallback. Jangan pernah menambahkan
# service_role atau sb_secret key ke aplikasi maupun GitHub Pages.
