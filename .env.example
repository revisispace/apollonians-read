# Nilai publik dari Supabase Dashboard -> Project Settings -> API.
# Publishable key memang digunakan di browser dan wajib dilindungi Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXAMPLE

# Endpoint HTTPS Edge TTS di Oracle Free VM.
# Untuk produksi Apollonians Read gunakan domain publik resmi.
NEXT_PUBLIC_EDGE_TTS_ENDPOINT=https://apollonians.duckdns.org

# Jangan pernah menaruh service_role, sb_secret, atau kredensial Oracle
# pada variabel NEXT_PUBLIC_* maupun repository.
