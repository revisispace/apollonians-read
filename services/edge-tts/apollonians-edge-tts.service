[Unit]
Description=Apollonians Read Edge TTS API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/apollonians-read/services/edge-tts
EnvironmentFile=/etc/apollonians-read/edge-tts.env
ExecStart=/opt/apollonians-read/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
